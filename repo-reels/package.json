{
  "name": "repo-reels",
  "version": "0.1.0",
  "private": true,
  "description": "Automated pipeline that turns trending GitHub repos into short explainer reels (HeyGen avatar + Remotion motion graphics)",
  "type": "module",
  "scripts": {
    "pipeline": "tsx src/pipeline/index.ts",
    "studio": "remotion studio src/remotion/index.ts",
    "render": "remotion render src/remotion/index.ts RepoReel out/reel.mp4 --props=out/timeline.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@remotion/cli": "4.0.290",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.290",
    "tsx": "^4.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "18.3.12",
    "typescript": "^5.6.0"
  }
}
