# --- Script generation (optional; falls back to a built-in template without it) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- HeyGen avatar (optional; without it the reel renders with a stylized placeholder) ---
HEYGEN_API_KEY=
# Your avatar id (list yours: curl -H "X-Api-Key: $HEYGEN_API_KEY" https://api.heygen.com/v2/avatars)
HEYGEN_AVATAR_ID=
# Voice id (list: curl -H "X-Api-Key: $HEYGEN_API_KEY" https://api.heygen.com/v2/voices)
HEYGEN_VOICE_ID=
# Set to "talking_photo" if HEYGEN_AVATAR_ID is a talking-photo id instead of a studio avatar
HEYGEN_AVATAR_TYPE=avatar

# --- GitHub (optional; raises rate limits for repo metadata) ---
GITHUB_TOKEN=

# --- Rendering ---
# Point Remotion at a pre-installed Chromium instead of downloading one
# REMOTION_BROWSER=/opt/pw-browsers/chromium
