{
  "name": "video-clone",
  "version": "1.0.0",
  "description": "Frame-accurate Remotion reconstruction of a 50s vertical short, with a placeholder avatar",
  "main": "index.js",
  "scripts": {
    "start": "remotion studio",
    "build": "remotion render VideoClone out/video-clone.mp4 --browser-executable=${CHROME:-/opt/pw-browsers/chromium_headless_shell-1194/chrome-linux/headless_shell}",
    "still": "remotion still VideoCloneSilent --browser-executable=${CHROME:-/opt/pw-browsers/chromium_headless_shell-1194/chrome-linux/headless_shell}",
    "typecheck": "tsc --noEmit"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@remotion/cli": "^4.0.516",
    "@remotion/renderer": "^4.0.516",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remotion": "^4.0.516"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "typescript": "^7.0.2"
  }
}